{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ironvale-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // Comma-separated origins allowed to open a room. Add the site's origin before deploying.
    "ALLOWED_ORIGINS": "tauri://localhost"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  // Connection attempts per client address: 30 a minute.
  "ratelimits": [{ "name": "JOIN_LIMITER", "namespace_id": "5311", "simple": { "limit": 30, "period": 60 } }]
}
