{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ironvale",
  "version": "../package.json",
  "identifier": "co.xanom.ironvale",
  "build": {
    "frontendDist": "./web",
    "devUrl": "http://127.0.0.1:5311",
    "beforeBuildCommand": "npm run build && node scripts/dev/app-stage.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "Ironvale",
        "width": 1600,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0E0E0D",
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Game",
    "shortDescription": "A first-person shooter",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/assets/dl": "assets/dl",
      "../public/assets/local": "assets/local"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFOUU5Q0I2QTg5NTZDOTMKUldTVGJKV290cHllVHFLdlNvQ3FYak01ZGpTS0xlMWxVMFpHRlc1blVYQUVpdjB4THd5L1BYTVAK",
      "endpoints": [
        "https://github.com/neelsatyavolu/ironvale/releases/latest/download/latest.json"
      ]
    }
  }
}
